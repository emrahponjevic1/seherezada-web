# ---------------------------------------------------------------------------
# OKOLJSKE SPREMENLJIVKE
#
# To je SAMO primer z imeni. Prave vrednosti nikoli ne pridejo v to datoteko
# in nikoli na GitHub.
#
# Kam vpišeš pravo geslo:
#   1) lokalno  -> naredi datoteko .env.local in vanjo vpiši spodnjo vrstico
#                  z resničnim geslom. .env.local je v .gitignore.
#   2) na spletu -> Vercel  ->  Settings  ->  Environment Variables
#
# Geslo je "geslo za dostop do aplikacij" iz Zoha (Settings -> Security ->
# App Passwords), NE geslo, s katerim se prijaviš v Zoho.
# ---------------------------------------------------------------------------

ZOHO_APP_PASSWORD=

# ---- QR kodovi in /statistika ---------------------------------------------
#
# DATABASE_URL  Postgres baza (Supabase). Vercelova integracija namesto tega
#               sama vpiše POSTGRES_URL — koda sprejme oboje.
#               Storage -> Supabase, regija Frankfurt (eu-central-1).
#               Lokalno ga prekopiraš iz Vercela (Settings -> Environment
#               Variables) v .env.local.
#
# CRON_SECRET   poljuben dolg niz. Vercel ga pošlje dnevni "budilki"
#               (/statistika/budilica), ki brezplačni Supabase ohranja budnega.
#
# ADMIN_GESLO   lozinka za /statistika. Izmisli dolgo geslo (vsaj 16 znakov).
#               Sprememba gesla odjavi vse naprave.

DATABASE_URL=
ADMIN_GESLO=
CRON_SECRET=
